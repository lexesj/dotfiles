# vim: set ft=zsh :

local name=""

for arg in "$@"; do
	case "$arg" in
	--help | -h)
		echo "Usage: dev ssh <name>"
		echo ""
		echo "Attaches to a devbox's tmux session, starting it first if it's stopped."
		return 0
		;;
	-*) echo "Unknown option: $arg" && return 1 ;;
	*) name="$arg" ;;
	esac
done

if [[ -z "$name" ]]; then
	echo "Usage: dev ssh <name>"
	return 1
fi

local box_status
box_status=$(_dev_status "$name")

if [[ -z "$box_status" ]]; then
	echo "No devbox named $name."
	return 1
elif [[ "$box_status" != "running" ]]; then
	_dev_start "$name" || return 1
fi

pay remote ssh "$name" --tmux
