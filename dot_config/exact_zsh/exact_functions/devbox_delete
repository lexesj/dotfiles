# vim: set ft=zsh :

local names=("$@")

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
	echo "Usage: devbox_delete <name...>"
	echo ""
	echo "Deletes devboxes."
	return 0
fi

if ((${#names} == 0)); then
	echo "Usage: devbox_delete <name...>"
	return 1
fi

echo "About to delete:"
printf '  %s\n' "${names[@]}"
read -q "?Continue? [y/N] " || {
	echo
	return 1
}
echo

# Deleted boxes go to the recycle bin; restore with `pay remote recover`.
pay remote delete --skip-confirm "${names[@]}"
_devbox_list --clear
