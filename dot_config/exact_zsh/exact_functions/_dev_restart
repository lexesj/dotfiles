# vim: set ft=zsh :

local name=""
local ssh=0
local tmux=0

for arg in "$@"; do
	case "$arg" in
	--ssh) ssh=1 ;;
	--tmux) tmux=1 ;;
	--help | -h)
		echo "Usage: dev restart [--ssh|--tmux] <name>"
		echo ""
		echo "Stops (if running) and starts a devbox."
		return 0
		;;
	-*) echo "Unknown option: $arg" && return 1 ;;
	*) name="$arg" ;;
	esac
done

if [[ -z "$name" ]]; then
	echo "Usage: dev restart [--ssh|--tmux] <name>"
	return 1
fi

local box_status
box_status=$(_dev_status "$name")

if [[ -z "$box_status" ]]; then
	echo "No devbox named $name."
	return 1
elif [[ "$box_status" == "running" ]]; then
	echo "Stopping devbox $name..."
	pay remote stop "$name" || return 1
else
	echo "Devbox $name is $box_status, skipping stop."
fi

_dev_start "$name" || return 1

if [[ $tmux -eq 1 ]]; then
	pay remote ssh "$name" --tmux
elif [[ $ssh -eq 1 ]]; then
	pay remote ssh "$name"
fi
