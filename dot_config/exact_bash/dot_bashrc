# vim: set ft=bash :

# Source shared shell config (functions, variables, PATH).
SHELL_CONFIG_DIR="$HOME/.config/shell"
if [[ -d "$SHELL_CONFIG_DIR" ]]; then
	for file in "$SHELL_CONFIG_DIR"/*.sh; do
		source "$file"
	done
fi

# Vi mode.
set -o vi

# Fzf.
if command -v fzf &>/dev/null; then
	source <(fzf --bash)
fi

# Zoxide.
if command -v zoxide &>/dev/null; then
	eval "$(zoxide init --cmd cd bash)"
fi

# sesh.
if command -v sesh &>/dev/null; then
	function sesh-sessions() {
		{
			exec </dev/tty
			exec <&1
			local session
			session=$(sesh list --tmux --config --zoxide --hide-duplicates | fzf --height 40% --reverse --border-label ' sesh ' --border --prompt '⚡  ')
			[[ -z "$session" ]] && return
			sesh connect "$session"
		}
	}

	bind -x '"\es": sesh-sessions'
fi
