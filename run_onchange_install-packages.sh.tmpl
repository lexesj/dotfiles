#!/usr/bin/env bash

{{- $apt := concat .packages.apt.common (index .packages.apt .profile | default list) }}
{{- $brew := concat .packages.brew.common (index .packages.brew .profile | default list) }}
{{- $cask := concat .packages.cask.common (index .packages.cask .profile | default list) }}

echo "Installing packages..."

{{ if and (eq .chezmoi.os "linux") $apt -}}
sudo apt update
sudo apt install -y {{ $apt | join " " }}
{{ end -}}

{{ if and (eq .chezmoi.os "darwin") (or $brew $cask) -}}
if command -v brew &>/dev/null; then
	brew bundle --file=/dev/stdin <<-EOF
		{{- range $brew }}
		brew {{ . | quote }}
		{{- end }}
		{{- range $cask }}
		cask {{ . | quote }}
		{{- end }}
	EOF
fi
{{ end -}}
