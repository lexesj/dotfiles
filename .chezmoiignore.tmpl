bin/

# Git repo files.
LICENSE
README.md
CLAUDE.md

# Neovim files.
.config/nvim/lazy-lock.json

{{- if has .profile (list "work" "devbox") }}
# Personal configs.
.ssh/config
.gitconfig
.config/mise/
.config/zsh/after/mise.zsh
.config/zsh/after/vite-plus.zsh
{{- end }}

{{- if eq .profile "server" }}
# Tools not installed on servers.
.claude/
.claude.json
.codex/
.config/bash/
.config/ghostty/
.config/karabiner/
.config/mise/
.config/zsh/after/mise.zsh
.config/zsh/completions/_bun
.local/bin/mise
# cloudflared isn't installed and the server doesn't SSH to itself.
.ssh/config
{{- end }}

{{- if has .profile (list "personal" "server") }}
# Work configs.
.config/nvim/lua/plugins/stripe/
.config/zsh/completions/_dev
.config/zsh/functions/
.config/zsh/rbenv.zsh
.local/bin/git
{{- end }}

{{- if not (has .profile (list "devbox" "server")) }}
# Ubuntu's fd-find installs as fdfind; alias it to fd on Linux.
.local/bin/fd
{{- end }}

{{- if ne .profile "devbox" }}
# Only devbox hooks the bash config into ~/.bashrc.
.bashrc
{{- end }}

{{- if eq .chezmoi.os "windows" }}
# Unix-only configs, externals and run_ scripts. `*.sh` only matches top-level
# names, so .claude/statusline-command.sh is still applied.
*.sh
.codex/
.config/bash/
.config/ghostty/
.config/karabiner/
.config/lazygit/
.config/mise/
.config/nvim/
.config/shell/
.config/zsh/
.config/zsh/**
.local/bin/
.oh-my-zsh/
.oh-my-zsh/**
.ssh/config
.tmux/
.tmux/**
.tmux.conf
.zshrc
{{- else }}
# Windows-only configs and run_ scripts.
*.ps1
.config/powershell/
AppData/
{{- end }}
